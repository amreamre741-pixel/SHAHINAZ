{
  "expo": {
    "name": "SHAHINAZ",
    "slug": "shahinaz",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "shahinaz",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shahinaz.app"
    },
    "android": {
      "package": "com.shahinaz.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج تطبيق SHAHINAZ للوصول إلى الصور لنشر المنشورات والقصص.",
          "cameraPermission": "يحتاج تطبيق SHAHINAZ للوصول إلى الكاميرا لالتقاط الصور."
        }
      ]
    ],
    "extra": {
      "supportsRTL": true,
      "privacyPolicyUrl": "https://amreamre741-pixel.github.io/SHAHINAZ/privacy.html"
    }
  }
}
