generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  email        String    @unique
  passwordHash String
  bio          String    @default("")
  avatarUrl    String    @default("")
  verified     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  posts        Post[]
  likes        Like[]
  comments     Comment[]
  reports      Report[]
  blocksMade   Block[]   @relation("Blocker")
  blocksRecvd  Block[]   @relation("Blocked")
  sentMsgs     Message[] @relation("Sender")
  recvdMsgs    Message[] @relation("Receiver")
  friendsSent  FriendRequest[] @relation("FriendSender")
  friendsRecvd FriendRequest[] @relation("FriendReceiver")
  liveRooms    LiveRoom[]
  roomMsgs     LiveRoomMessage[]
}

model Post {
  id        String    @id @default(cuid())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String    @default("")
  imageUrl  String    @default("")
  videoUrl  String    @default("")
  location  String    @default("")
  createdAt DateTime  @default(now())

  likes     Like[]
  comments  Comment[]
  reports   Report[]

  @@index([createdAt(sort: Desc)])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  text      String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  postId     String
  reason     String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  text        String   @default("")
  imageUrl    String   @default("")
  audioUrl    String   @default("")
  durationSec Int      @default(0)
  sender      User     @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([senderId, receiverId, createdAt])
}

model FriendRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("PENDING")
  sender     User     @relation("FriendSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("FriendReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([senderId, receiverId])
}

model LiveRoom {
  id        String   @id @default(cuid())
  hostId    String
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  title     String
  topic     String   @default("دردشة مباشرة")
  kind      String   @default("LIVE")
  isActive  Boolean  @default(true)
  viewers   Int      @default(1)
  createdAt DateTime @default(now())

  messages  LiveRoomMessage[]
}

model LiveRoomMessage {
  id          String   @id @default(cuid())
  roomId      String
  userId      String
  text        String   @default("")
  audioUrl    String   @default("")
  durationSec Int      @default(0)
  room        LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([roomId, createdAt])
}
